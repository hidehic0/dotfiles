  "MergeSortTree": {
    "prefix": "mergesorttree",
    "body": [
      "vvi D;",
      "ll _n;",
      "",
      "void build(vi V) {",
      "  _n = V.size(), D.resize(_n * 2);",
      "",
      "  for (int i = 0; i < _n; i++) {",
      "    D[i + _n].emplace_back(V[i]);",
      "  }",
      "",
      "  for (int i = _n * 2 - 1; i >= 1; i--) {",
      "    if (((i << 1) | 1) < _n * 2) {",
      "      int a = i << 1, b = (i << 1) | 1;",
      "",
      "      for (int aind = 0, bind = 0; aind < D[a].size() || bind < D[b].size();",
      "           aind++, bind++) {",
      "        if (aind == D[a].size()) {",
      "          D[i].emplace_back(D[b][bind++]);",
      "        } else if (bind == D[b].size() || D[a][aind] <= D[b][bind]) {",
      "          D[i].emplace_back(D[a][aind++]);",
      "        } else {",
      "          D[i].emplace_back(D[b][bind++]);",
      "        }",
      "      }",
      "    } else if ((i << 1) < _n * 2) {",
      "      D[i] = D[i << 1];",
      "    }",
      "",
      "    /* ここで前計算したい場合やる(累積和など) */",
      "  }",
      "}",
      "",
      "// queryで使う部分を求める",
      "vector<int> query_pos(int l, int r) {",
      "  assert(0 <= l && l <= r && r < _n);",
      "  vector<int> res;",
      "",
      "  for (l += _n, r += _n; l < r; l >>= 1, r >>= 1) {",
      "    if (l & 1)",
      "      res.emplace_back(l++);",
      "    if (r & 1)",
      "      res.emplace_back(--r);",
      "  }",
      "",
      "  return res;",
      "}",
      ""
    ],
    "description": "MergeSortTree"
  }
}
