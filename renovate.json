{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "nixos"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "extends": [
    "config:base",
    "github>Omochice/renovate-config:deno"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automergeSchedule": [
      "at any time"
    ],
    "extends": [
      "schedule:daily"
    ]
  }
}
